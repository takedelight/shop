{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --env-file=../../.env next dev",
    "build": "bun --env-file=../../.env next build",
    "start": "bun next start",
    "typecheck": "bun tsc --noEmit",
    "db:generate": "bun run --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun run --env-file=../../.env drizzle-kit migrate",
    "db:studio": "bun run --env-file=../../.env drizzle-kit studio"
  },
  "dependencies": {
    "@remixicon/react": "^4.9.0",
    "@shop/ui": "workspace:*",
    "better-auth": "^1.7.12",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
