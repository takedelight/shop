{
  "name": "shop",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "fullcheck": "oxlint . && oxfmt --check . && turbo run typecheck",
    "clean": "turbo clean",
    "prepare": "husky",
    "test": "bun --filter @shop/web test",
    "test:watch": "bun --filter @shop/web test:watch"
  },
  "dependencies": {
    "@hookform/resolvers": "^6.0.0",
    "react-hook-form": "^7.91.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript-eslint/utils": "^8.72.0",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tailwindcss": "^4",
    "turbo": "^2.11.10"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "packageManager": "bun@1.4.2"
}
